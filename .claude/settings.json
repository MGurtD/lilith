{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(pnpm run i18n:check *)",
      "Bash(pnpm run i18n:audit *)",
      "Bash(pnpm run i18n:audit:test *)",
      "Bash(pnpm run typecheck *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run smoke *)"
    ],
    "ask": [
      "Bash(dotnet ef *)",
      "Bash(dotnet run *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env.local)",
      "Bash(npm *)",
      "Bash(yarn *)"
    ]
  }
}
