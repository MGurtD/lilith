{
  "name": "lilith-frontend",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node ./scripts/check-i18n-parity.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "build:versioned": "VITE_APP_VERSION=%npm_package_version% pnpm run build",
    "build-development": "pnpm run typecheck && vite build --mode development --outDir dist-test",
    "build-preprod": "pnpm run typecheck && vite build --mode preprod --outDir dist-preprod",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/core": "^4.5.5",
    "@vuelidate/core": "^2.0.2",
    "@vuelidate/validators": "^2.0.2",
    "axios": "^1.18.1",
    "chart.js": "^4.2.1",
    "dompurify": "^3.4.11",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.12.0",
    "pinia": "^2.1.7",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vee-validate": "^4.10.1",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.1",
    "vue-i18n": "^11.4.6",
    "vue-pdf-embed": "^2.1.5",
    "vue-router": "^4.4.5",
    "vue-sidebar-menu": "^5.2.8",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^3.3.6",
    "workbox-window": "^7.4.0"
  }
}
